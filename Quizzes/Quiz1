#include <iostream>
#include <vector>
#include <string>
#include <cstdlib>
#include <ctime>

using namespace std;

// Assigns an integer for the cards to categorize them
const int CIVILIAN = 0;
const int EMPEROR = 1;
const int SLAVE = 2;

// Functions and integers
vector<int> createDeck(string side);
void displayDeck(const vector<int>& deck);
int getWager(int mmLeft);
int playerPlayCard(vector<int>& deck);
int enemyPlayCard(vector<int>& deck);
int Matchup(int playerCard, int enemyCard);
void playRound(int round, int& mmLeft, long long& moneyEarned);

int main() {
    srand(time(0));

    int round = 1;
    int mmLeft = 30;
    long long moneyEarned = 0;

    cout << "== GAME START ==\n";

    // Loop until 12 rounds are finished or the eardrum is pierced
    while (round <= 12 && mmLeft > 0) {
        playRound(round, mmLeft, moneyEarned);
        round++;
    }

    // Determine and display the final ending result
    cout << "\nGAME OVER\n";
    cout << "Final Earnings: " << moneyEarned << " Yen\n";
    cout << "Millimeters Left: " << mmLeft << "mm\n";

    if (mmLeft <= 0) {
        cout << "Bad Ending (Eardrum has been Pierced)\n";
    }
    else if (moneyEarned >= 20000000) {
        cout << "Best Ending (Won 20M+ Yen)\n";
    }
    else {
        cout << "Meh Ending (Survived but missed 20M goal)\n";
    }

    return 0;
}

// Generates a 5 card deck for the player
vector<int> createDeck(string side) {
    vector<int> deck;
    for (int i = 0; i < 4; i++) {
        deck.push_back(CIVILIAN);
    }
    if (side == "Emperor") {
        deck.push_back(EMPEROR);
    }
    else {
        deck.push_back(SLAVE);
    }
    return deck;
}

// Shows what current cards you have using a clean switch statement
void displayDeck(const vector<int>& deck) {
    cout << "Your cards: ";
    for (size_t i = 0; i < deck.size(); i++) {
        cout << "[" << i + 1 << ": ";
        switch (deck[i]) {
        case CIVILIAN: cout << "Civilian"; break;
        case EMPEROR:  cout << "Emperor";  break;
        case SLAVE:    cout << "Slave";    break;
        }
        cout << "] ";
    }
    cout << "\n";
}

// 1mm-30mm wage request for the round
int getWager(int mmLeft) {
    int wager;
    while (true) {
        cout << "Enter wager (1 to " << mmLeft << "mm): ";
        cin >> wager;
        if (wager >= 1 && wager <= mmLeft) return wager;
        cout << "Invalid bet! Try again.\n";
    }
}

// Handles the user's card and deletes it from vector 
int playerPlayCard(vector<int>& deck) {
    int choice;
    while (true) {
        displayDeck(deck);
        cout << "Choose a card to play: ";
        cin >> choice;

        if (choice >= 1 && choice <= (int)deck.size()) {
            int playedCard = deck[choice - 1];
            deck.erase(deck.begin() + (choice - 1)); // removes card cleanly from vector
            return playedCard;
        }
        cout << "Invalid card. Try again.\n";
    }
}

// Selects a randomized card for opponent and deletes it from vector 
int enemyPlayCard(vector<int>& deck) {
    int index = rand() % deck.size();
    int playedCard = deck[index];
    deck.erase(deck.begin() + index); // removes card cleanly from vector
    return playedCard;
}

// Evaluates who wins the match 
int Matchup(int playerCard, int enemyCard) {
    if (playerCard == enemyCard) return 0; // tie

    switch (playerCard) {
    case EMPEROR:
        if (enemyCard == CIVILIAN) {
            return 1;
        }
        else {
            return -1;
        }
    case CIVILIAN:
        if (enemyCard == SLAVE) {
            return 1;
        }
        else {
            return -1;
        }
    case SLAVE:
        if (enemyCard == EMPEROR) {
            return 1;
        }
        else {
            return -1;
        }
    default:
        return -1;
    }
}

// Executes a round in order
void playRound(int round, int& mmLeft, long long& moneyEarned) {
    string sideSchedule[] = {
        "Emperor", "Emperor", "Emperor",
        "Slave", "Slave", "Slave",
        "Emperor", "Emperor", "Emperor",
        "Slave", "Slave", "Slave"
    };

    string kaijiSide = sideSchedule[round - 1];
    string tonegawaSide;

    if (kaijiSide == "Emperor") {
        tonegawaSide = "Slave";
    }
    else {
        tonegawaSide = "Emperor";
    }

    cout << "\n=== ROUND " << round << " (" << kaijiSide << " Side) ===\n";
    cout << "Stats: " << mmLeft << "mm left | " << moneyEarned << " Yen earned\n";

    int currentWager = getWager(mmLeft);
    vector<int> kaijiHand = createDeck(kaijiSide);
    vector<int> tonegawaHand = createDeck(tonegawaSide);

    while (true) {
        int pCard = playerPlayCard(kaijiHand);
        int eCard = enemyPlayCard(tonegawaHand);

        // card choices of the players and display what they chose
        string pCardStr, eCardStr;
        switch (pCard) {
        case CIVILIAN: pCardStr = "Civilian";
            break;
        case EMPEROR:  pCardStr = "Emperor";
            break;
        case SLAVE:    pCardStr = "Slave";
            break;
        }
        switch (eCard) {
        case CIVILIAN: eCardStr = "Civilian";
            break;
        case EMPEROR:  eCardStr = "Emperor";
            break;
        case SLAVE:    eCardStr = "Slave";
            break;
        }

        cout << "You played " << pCardStr << " vs Tonegawa's " << eCardStr << "\n";

        // win/lose outcome in the match
        int result = Matchup(pCard, eCard);
        if (result == 1) {
            long long reward = 0;

            if (kaijiSide == "Emperor") {
                reward = currentWager * 100000LL;
            }
            else {
                reward = currentWager * 500000LL;
            }
            moneyEarned += reward;
            cout << "You won this round. Earned " << reward << " Yen.\n";
            break;
        }
        else if (result == -1) {
            mmLeft -= currentWager;
            cout << "You lost this round. Lost " << currentWager << "mm.\n";
            break;
        }
        else {
            cout << "Both played Civilian. Play another card\n\n";
        }
    }
}
